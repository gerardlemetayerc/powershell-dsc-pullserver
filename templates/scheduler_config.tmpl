{{define "content"}}
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Scheduler</h1>
            </div>
        </div>
    </div>
</section>
<section class="content">
  <div class="container-fluid">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Tasks</h3>
      </div>
      <div class="card-body table-responsive p-0">
        <table class="table table-striped table-hover mb-0" id="scheduler-tasks-table">
          <thead>
            <tr>
              <th>Task</th>
              <th>Enabled</th>
              <th>Next run</th>
              <th>Last run</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="scheduler-tasks-body">
            <tr><td colspan="6" class="text-center text-muted">Loading tasks...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="card-footer">
        <span id="scheduler-config-status" class="small"></span>
      </div>
    </div>
  </div>
</section>

<div class="modal fade" id="schedulerHistoryModal" tabindex="-1" role="dialog" aria-labelledby="schedulerHistoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="schedulerHistoryModalLabel">Task history</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body table-responsive">
        <table class="table table-sm table-striped mb-0">
          <thead>
            <tr>
              <th>Started</th>
              <th>Finished</th>
              <th>Status</th>
              <th>Trigger</th>
              <th>Message</th>
            </tr>
          </thead>
          <tbody id="scheduler-history-body">
            <tr><td colspan="5" class="text-center text-muted">No history</td></tr>
          </tbody>
        </table>
      </div>
      <div class="modal-footer justify-content-between">
        <div id="scheduler-history-page-info" class="text-muted small">Page 1</div>
        <div>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="scheduler-history-prev">Previous</button>
          <button type="button" class="btn btn-sm btn-outline-secondary ml-2" id="scheduler-history-next">Next</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="reportConfigModal" tabindex="-1" role="dialog" aria-labelledby="reportConfigModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reportConfigModalLabel">Configure report cleanup</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group form-check">
          <input type="checkbox" class="form-check-input" id="modal_enable_report_auto_cleanup">
          <label class="form-check-label" for="modal_enable_report_auto_cleanup">Enable automatic report cleanup</label>
        </div>
        <div class="form-group">
          <label for="modal_report_retention_days">Keep reports for (days)</label>
          <input type="number" min="1" class="form-control" id="modal_report_retention_days" required>
        </div>
        <div class="form-group">
          <label for="modal_report_cleanup_interval_mins">Execution interval (minutes)</label>
          <input type="number" min="1" class="form-control" id="modal_report_cleanup_interval_mins" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="save-report-config">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="releaseConfigModal" tabindex="-1" role="dialog" aria-labelledby="releaseConfigModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="releaseConfigModalLabel">Configure release check</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group form-check">
          <input type="checkbox" class="form-check-input" id="modal_enable_release_check">
          <label class="form-check-label" for="modal_enable_release_check">Enable periodic check for the latest GitHub release</label>
        </div>
        <div class="form-group">
          <label for="modal_release_check_interval_mins">Release check interval (minutes)</label>
          <input type="number" min="1" class="form-control" id="modal_release_check_interval_mins" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="save-release-config">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="logsConfigModal" tabindex="-1" role="dialog" aria-labelledby="logsConfigModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="logsConfigModalLabel">Configure log rotation</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div class="form-group form-check">
          <input type="checkbox" class="form-check-input" id="modal_enable_log_rotation">
          <label class="form-check-label" for="modal_enable_log_rotation">Enable log rotation</label>
        </div>
        <div class="form-group">
          <label for="modal_log_rotate_max_size_mb">Log rotate max size (MB)</label>
          <input type="number" min="1" class="form-control" id="modal_log_rotate_max_size_mb" required>
        </div>
        <div class="form-group">
          <label for="modal_log_rotate_max_backups">Log rotate max backups</label>
          <input type="number" min="1" class="form-control" id="modal_log_rotate_max_backups" required>
        </div>
        <div class="form-group">
          <label for="modal_log_rotate_max_age_days">Log rotate max age (days)</label>
          <input type="number" min="1" class="form-control" id="modal_log_rotate_max_age_days" required>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="save-logs-config">Save</button>
      </div>
    </div>
  </div>
</div>
<script src="/web/scheduler_config.js"></script>
{{end}}
