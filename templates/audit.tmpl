                <tr>
                    <th>Email</th>
                    <th>Action</th>
                    <th>Cible</th>
                    <th>Détails</th>
                    <th>Date</th>
                </tr>
            </thead>
        </table>
    </div>
</div>
<script src="/web/admin_audit.js"></script>
{{end}}
